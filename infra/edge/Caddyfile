# The one public entry point on the Trik server. Cloudflare (proxied, SSL "Full (strict)") → this Caddy → apps.
# TLS uses the Cloudflare Origin Certificate mounted at /certs (no ACME: the server is never reachable directly).
import /etc/caddy/cloudflare-ips.caddy

{
	admin off
	auto_https disable_certs
	servers {
		# Only TCP 443 is published (and only Cloudflare reaches it): don't advertise HTTP/3.
		protocols h1 h2
		import cloudflare_ranges
		client_ip_headers CF-Connecting-IP
		strict_sni_host on
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-Via
	}
}

(origin_tls) {
	tls /certs/origin.pem /certs/origin.key
}

# ---------------------------------------------------------------- landing (static, apps/landing)
www.{$LANDING_DOMAIN} {
	import origin_tls
	redir https://{$LANDING_DOMAIN}{uri} permanent
}

{$LANDING_DOMAIN} {
	import origin_tls
	import security_headers
	header {
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	encode zstd gzip
	root * /srv/landing

	# Hashed build assets never change; pages are revalidated.
	@assets path /_nuxt/* /_fonts/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_nuxt/* /_fonts/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	try_files {path} {path}/index.html {path}.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

# ---------------------------------------------------------------- web app (static single-page app, apps/web)
{$APP_DOMAIN} {
	import origin_tls
	import security_headers
	header {
		X-Frame-Options DENY
		# The app only talks to the API (and its WebSocket); nothing else is loaded or framed.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://{$API_DOMAIN} wss://{$API_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	encode zstd gzip
	root * /srv/app

	@assets path /_nuxt/* /_fonts/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_nuxt/* /_fonts/*
	header @pages Cache-Control "no-cache"

	# Build assets are files or a 404 (never index.html in place of a script).
	handle @assets {
		file_server
	}
	# Every other route is the app's: a deep link (/orders/…, /settings/stores?…) gets index.html.
	handle {
		try_files {path} /index.html
		file_server
	}
}

# ---------------------------------------------------------------- API (apps/api) and real time (Centrifugo)
{$API_DOMAIN} {
	import origin_tls
	import security_headers

	# Above the app's own limits (2 MB API, 1 MB webhooks), so the app answers with its problem+json.
	request_body {
		max_size 4MB
	}

	handle /connection/websocket* {
		reverse_proxy centrifugo:8000
	}

	handle {
		reverse_proxy api:8080 {
			# The real visitor, from Cloudflare's header (trusted above). Replaces anything the client sent,
			# so per-IP rate limits can't be dodged with a forged X-Forwarded-For.
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https
			health_uri /healthz
			health_interval 10s
		}
	}
}

# ---------------------------------------------------------------- anything else: no answer at all
# A request for a host not listed above (a scanner, a misconfigured DNS record) gets its connection closed.
:443 {
	import origin_tls
	abort
}
