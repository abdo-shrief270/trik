# Managed by Ansible (infra/ansible). deploy.sh changes IMAGE_TAG; everything else comes from the vault.
IMAGE_REPO={{ image_repo }}
IMAGE_TAG={{ image_tag }}

LANDING_DOMAIN=trik.chat
API_DOMAIN=api.trik.chat
APP_DOMAIN=app.trik.chat

POSTGRES_SUPERUSER_PASSWORD={{ postgres_superuser_password }}
DB_OWNER_PASSWORD={{ db_owner_password }}
DB_API_PASSWORD={{ db_api_password }}

REDIS_PASSWORD={{ redis_password }}
CENTRIFUGO_API_KEY={{ centrifugo_api_key }}
CENTRIFUGO_TOKEN_HMAC_SECRET={{ centrifugo_token_hmac_secret }}

# Backups (docs/runbooks/backups.md). The off-server bucket and the alert URL are optional.
BACKUP_CIPHER_PASS={{ backup_cipher_pass }}
BACKUP_S3_BUCKET={{ backup_s3_bucket | default('') }}
BACKUP_S3_ENDPOINT={{ backup_s3_endpoint | default('') }}
BACKUP_S3_REGION={{ backup_s3_region | default('auto') }}
BACKUP_S3_KEY={{ backup_s3_key | default('') }}
BACKUP_S3_KEY_SECRET={{ backup_s3_key_secret | default('') }}
BACKUP_ALERT_URL={{ backup_alert_url | default('') }}

PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE_SIZE=8GB
PG_MEMORY=6g
API_MEMORY=2g
WORKER_REPLICAS=2
REDIS_MAXMEMORY=1536mb
