# Managed by Ansible (infra/ansible): the Laravel environment for api, worker, scheduler and migrate.

APP_NAME=Trik
APP_ENV=production
APP_DEBUG=false
APP_KEY={{ app_key }}
APP_URL=https://api.trik.chat
FRONTEND_URL=https://app.trik.chat
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=trik
DB_USERNAME=trik_api
DB_PASSWORD={{ db_api_password }}
DB_ROLE=trik_app
DB_SSLMODE=disable

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ redis_password }}
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=.trik.chat
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=app.trik.chat

OCTANE_SERVER=frankenphp
# Only the edge container may set the client IP (it takes it from Cloudflare, see infra/edge/Caddyfile).
TRUSTED_PROXIES=172.30.0.10
CORS_ALLOWED_ORIGINS=https://app.trik.chat

CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY={{ centrifugo_api_key }}

# No email provider yet: account emails are written to the log. Switch to smtp (or an API mailer) before
# public sign-up opens (verification and password reset need it).
{% if mail_smtp_host | default('') %}
# Sending only (verification, password resets): a transactional provider, see docs/runbooks/deploy.md
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST={{ mail_smtp_host }}
MAIL_PORT={{ mail_smtp_port | default(587) }}
MAIL_USERNAME={{ mail_smtp_username }}
MAIL_PASSWORD={{ mail_smtp_password }}
{% else %}
# No email provider yet: messages go to the log (sign-up can't verify email until one is set)
MAIL_MAILER=log
{% endif %}
MAIL_FROM_ADDRESS={{ mail_from_address | default('no-reply@trik.chat') }}
MAIL_FROM_NAME=Trik

WHATSAPP_DEFAULT_COUNTRY_CODE=20
WHATSAPP_WEBHOOK_BASE_URL=https://api.trik.chat
WHATSAPP_QUEUE=default
META_APP_SECRET={{ meta_app_secret }}
META_WEBHOOK_VERIFY_TOKEN={{ meta_webhook_verify_token }}

# Features rolled out per workspace: all, none, or workspace ids (vars.yml)
FEATURE_COMMERCE={{ feature_commerce | default('none') }}
FEATURE_RISK={{ feature_risk | default('none') }}

# Store connectors (vault.yml; empty until the apps exist, see the Commerce README)
COMMERCE_PUBLIC_URL=https://api.trik.chat
SHOPIFY_CLIENT_ID={{ shopify_client_id | default('') }}
SHOPIFY_CLIENT_SECRET={{ shopify_client_secret | default('') }}
SHOPIFY_PREVIOUS_CLIENT_SECRET={{ shopify_previous_client_secret | default('') }}
