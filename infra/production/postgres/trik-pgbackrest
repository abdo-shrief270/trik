#!/bin/sh
# pgBackRest with Trik's settings, which compose passes as PGBACKREST_* variables. Compose always sets the
# off-server repository's (repo2) variables, empty until it is configured, and pgBackRest rejects empty options:
# drop the empty ones, and all of repo2's while it has no bucket. Postgres's archive_command and restore_command
# call this too (PGBACKREST_CMD), so every pgBackRest run sees the same settings.
for v in $(env | sed -n 's/^\(PGBACKREST_[A-Z0-9_]*\)=$/\1/p'); do unset "$v"; done
if [ -z "${PGBACKREST_REPO2_S3_BUCKET:-}" ]; then
  for v in $(env | sed -n 's/^\(PGBACKREST_REPO2_[A-Z0-9_]*\)=.*/\1/p'); do unset "$v"; done
fi
exec pgbackrest "$@"
