# /srv/trik/.env on the server: read by compose.yml. Written by Ansible from the vault; never committed.
# Generate each secret with: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# Images (built by .github/workflows/deploy.yml). deploy.sh sets IMAGE_TAG.
IMAGE_REPO=ghcr.io/<github-owner>
IMAGE_TAG=latest

LANDING_DOMAIN=trik.chat
API_DOMAIN=api.trik.chat

# PostgreSQL: superuser (admin only), the owner role (migrations, scheduler) and the API login.
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_API_PASSWORD=

REDIS_PASSWORD=
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=

# Sizing for a KVM 4 (16 GB). Halve for anything smaller.
PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE_SIZE=8GB
PG_MEMORY=6g
API_MEMORY=2g
WORKER_REPLICAS=2
REDIS_MAXMEMORY=1536mb
