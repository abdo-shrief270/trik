APP_NAME=Trik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trik
DB_USERNAME=trik
DB_PASSWORD=trik_local_only
# The app drops to this role on connect so row-level security applies.
DB_ROLE=trik_app
# Migrations run on the "owner" connection (defaults to DB_USERNAME/DB_PASSWORD).
# DB_OWNER_USERNAME=
# DB_OWNER_PASSWORD=

OCTANE_SERVER=frankenphp
SANCTUM_STATEFUL_DOMAINS=localhost:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# In production the web app (app.trik.chat) and API (api.trik.chat) share cookies: SESSION_DOMAIN=.trik.chat
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@trik.chat"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp (see modules/WhatsApp/README.md)
WHATSAPP_DEFAULT_COUNTRY_CODE=20
# Public URL providers call back; use a tunnel (cloudflared/ngrok) locally.
WHATSAPP_WEBHOOK_BASE_URL=
WHATSAPP_QUEUE=default
D360_BASE_URL=https://waba-v2.360dialog.io
META_GRAPH_VERSION=v24.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_MPS=80
WHATSAPP_WEBHOOK_RETENTION_MONTHS=2
WHATSAPP_INBOUND_KEYS_DAYS=30

# Security (docs/security/2026-11-review.md)
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_TOKEN_EXPIRATION_MINUTES=86400
MAX_BODY_BYTES_API=2097152
MAX_BODY_BYTES_WEBHOOKS=1048576
MAX_OWNED_WORKSPACES=10
# Production: true (default when APP_ENV=production)
# SESSION_SECURE_COOKIE=true

# Proxies in front of the app (Caddy on the same host by default). Add the load balancer / private
# network ranges here; never "*" unless the app port is unreachable from outside.
TRUSTED_PROXIES=127.0.0.1,::1
# Logs can contain customer data (e.g. SQL bindings in errors): keep them short-lived.
LOG_DAILY_DAYS=14
