# Local development only. Copy to .env. Never use these values anywhere else.
COMPOSE_PROJECT_NAME=trik

# PostgreSQL
POSTGRES_DB=trik
POSTGRES_USER=trik
POSTGRES_PASSWORD=trik_local_only
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# Redis (three roles: cache, queues, locks/rate limits)
REDIS_CACHE_PORT=6379
REDIS_QUEUE_PORT=6380
REDIS_LOCK_PORT=6381

# Redpanda (Kafka API)
REDPANDA_KAFKA_PORT=19092
REDPANDA_CONSOLE_PORT=8085

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=trik
CLICKHOUSE_PASSWORD=trik_local_only

# Meilisearch
MEILI_PORT=7700
MEILI_MASTER_KEY=trik_local_only_master_key_change_me

# Centrifugo (real-time)
CENTRIFUGO_PORT=8000
CENTRIFUGO_API_KEY=trik_local_only_api_key
CENTRIFUGO_TOKEN_HMAC_SECRET=trik_local_only_hmac_secret
CENTRIFUGO_ADMIN_PASSWORD=trik_local_only

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# MinIO (S3-compatible storage for media)
MINIO_ROOT_USER=trik
MINIO_ROOT_PASSWORD=trik_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
